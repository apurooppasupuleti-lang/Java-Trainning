<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"

       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

       xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="creditCard" class="demo.service.CreditCard">
    </bean>
    <bean id="email" class="demo.service.EmailNotification"></bean>
    <bean id="expenseManager" class="demo.service.ExpenseManager">
        <constructor-arg ref="creditCard"></constructor-arg>
        <constructor-arg ref="email"></constructor-arg>
    </bean>
</beans>

